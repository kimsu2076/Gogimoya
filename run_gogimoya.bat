@echo off
set STEP=%1

if "%STEP%"=="" (
    echo [❌ 에러] 기능 이름을 입력해주세요! (예: run_gogimoya db-vo)
    exit /b
)

echo ===================================================
echo 🚀 [Step 1/4] Git 작업용 새 브랜치 생성: feature/%STEP%
echo ===================================================
git checkout -b feature/%STEP%

echo ===================================================
echo 🤖 [Step 2/4] 제미니 CLI 가동 및 자동 코딩/디자인 시작...
echo ===================================================
:: 제미니 CLI 명령어 규격에 맞게 아래 한 줄만 살짝 고쳐주시면
:: 아래는 guide폴더의 기본 지시서에 입력한 미션을 합쳐서 제미니에게 던지는 표준 양식이에용.
gemini-cli --context=./guide --prompt="guide/instrustCLI01.txt의 규칙을 따르고, 이번 스텝인 [%STEP%] 기능을 완성하라."

echo ===================================================
echo 📦 [Step 3/4] AI 작업물 자동 Git 스테이징 및 커밋 생성
echo ===================================================
git add .
git commit -m "feat: %STEP% 구현 완료 (프로그레스 주석 추가)"

echo ===================================================
echo 🚀 [Step 4/4] 깃허브 원격 저장소로 자동 푸시!
echo ===================================================
git push origin feature/%STEP%

echo ===================================================
echo 🎉 [성공] feature/%STEP% 브랜치 작업 및 자동 푸시가 완료되었습니다!
echo ===================================================